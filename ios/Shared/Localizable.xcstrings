{
  "sourceLanguage": "en",
  "strings": {
    "%@\n\n⤷ 正在进行：%@\n（锁屏卡片可直接批准，或长按这条通知）": {
      "comment": "APNs loc-key sent by the Mac hook; key is the Chinese source text.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n⤷ In progress: %@\n(Approve from the Lock Screen card, or long-press this notification)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n⤷ 正在进行：%@\n（锁屏卡片可直接批准，或长按这条通知）"
          }
        }
      }
    },
    "%@\n（锁屏卡片可直接批准，或长按这条通知）": {
      "comment": "APNs loc-key sent by the Mac hook; key is the Chinese source text.",
